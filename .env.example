# Copy to .env and fill in. .env is gitignored — never commit real keys.

# Required: speech-to-text runs on HF Whisper whatever the chat provider is.
HUGGINGFACE_API_KEY=

# The key for whichever `platform` is set in config.py. Cohere is the default.
COHERE_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GROQ_API_KEY=
# ollama needs no key

# Optional: seconds of silence before it decides you've finished talking.
# WILCO_PAUSE=2.5

# Optional: the voice it starts with, and how fast it talks (percent on top of that voice's
# own pace). Say "switch to ryan" or "talk faster" to change either mid-conversation; that
# choice is saved to .wilco_voice.json, which then wins over these.
# WILCO_VOICE=ava        # ava andrew emma brian sonia ryan neerja prabhat natasha madhur swara david zira
# WILCO_SPEED=25

# Optional: sending email. For Gmail this MUST be an App Password (Google account ->
# WILCO_EMAIL=you@gmail.com
# WILCO_EMAIL_PASSWORD=abcd efgh ijkl mnop
# WILCO_SMTP=smtp.gmail.com:465        # Outlook: smtp-mail.outlook.com:587
