# Copy to .env and fill in. .env is gitignored — never commit real keys.
#
# This file is the whole of Wilco's configuration. Every value below has a default in
# config.py and nothing else in the code hardcodes one, so .env is the only file to edit.
# Uncommented lines here are what those defaults are — change a value, restart, done.

# ---------------------------------------------------------------- keys (required)
# Speech-to-text runs on HF Whisper whatever the chat provider is.
HUGGINGFACE_API_KEY=

# The key for whichever WILCO_PLATFORM is set below. Cohere is the default.
COHERE_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GROQ_API_KEY=
# ollama needs no key

# ---------------------------------------------------------------- which brain
# WILCO_PLATFORM=cohere              # openai anthropic cohere huggingface groq nvidia ollama
# WILCO_CHAT_MODEL=command-a-03-2025
# WILCO_STT_MODEL=openai/whisper-large-v3
# WILCO_MAX_STEPS=6                  # tool rounds in one turn before it stops and says so
# WILCO_MAX_MESSAGES=40              # how much conversation it keeps
# WILCO_EMPTY_TRIES=3                # retries when the provider generates nothing at all
# WILCO_LLM_TIMEOUT=30               # seconds before a stalled request is given up on
#
# Free and working today, with the key you already have:
#   WILCO_PLATFORM=nvidia
#   WILCO_CHAT_MODEL=nvidia/llama-3.3-nemotron-super-49b-v1.5
#   WILCO_LLM_TIMEOUT=90
#   NVIDIA_API_KEY=<the same nvapi-... key>

# ---------------------------------------------------------------- listening
# How long you may go quiet mid-sentence before it decides you've finished. Raise it if
# you're still being cut off, lower it if replies feel sluggish.
# WILCO_PAUSE=2.5
# WILCO_MIN_PHRASE=0.4               # shorter than this isn't speech
# WILCO_MAX_PHRASE=45                # longest single utterance it will collect
# WILCO_LISTEN_TIMEOUT=8             # give up waiting for you to start talking

# ---------------------------------------------------------------- speaking
# Voice pack: ava andrew emma brian sonia ryan neerja prabhat natasha madhur swara david zira
# Speed is a percentage on top of that voice's own pace, -50 to 100.
# These are what it starts as, every time. Saying "switch to ryan" or "talk faster" changes
# it for that session only — there is no second settings file to disagree with this one.
# WILCO_VOICE=ava
# WILCO_SPEED=25
# WILCO_SPEED_STEP=15                # how much "talk faster" moves it
# WILCO_SPEECH_FIRST_GROUP=90        # characters spoken before the rest is even synthesised
# WILCO_SPEECH_LATER_GROUP=400
# WILCO_SPEECH_LEAST_GROUP=40
# WILCO_SPEECH_CACHE=120             # cache lines up to this length, so repeats are instant

# ---------------------------------------------------------------- how it decides
# WILCO_FUZZ_MIN=70                  # how close a spoken name must be to count as a match
# WILCO_FAST_WORDS=9                 # longer than this goes to the agent, not the regex path
# WILCO_LIST_LIMIT=40                # rows printed when it lists your files
# WILCO_MAX_CONTROLS=300             # controls read out of one window
# WILCO_ASK_WHAT_NEXT=false          # true brings back "what would you like to do next?"

# ---------------------------------------------------------------- running things
# WILCO_SHELL_TIMEOUT=25             # seconds before a shell command is given up on
# WILCO_MAX_OUTPUT=3000              # characters of command output handed back
# WILCO_TEXT_LIMIT=6000              # characters read out of a file
# WILCO_BROWSER_WAIT=12              # seconds to wait for a new browser window to appear
# WILCO_BROWSER_GRACE=2.5            # extra wait for that window to name itself private

# ---------------------------------------------------------------- files
# ;-separated folders to limit the file scan to. Unset means every drive.
# WILCO_ROOT=C:\Users\me\Music;D:\Media

# ---------------------------------------------------------------- sending email
# For Gmail this MUST be an App Password, not the account password.
# WILCO_EMAIL=you@gmail.com
# WILCO_EMAIL_PASSWORD=abcd efgh ijkl mnop
# WILCO_SMTP=smtp.gmail.com:465      # Outlook: smtp-mail.outlook.com:587
