# Copy to .env and fill in. .env is gitignored — never commit real keys.

# Required: speech-to-text runs on HF Whisper whatever the chat provider is.
HUGGINGFACE_API_KEY=

# The key for whichever `platform` is set in config.py. Cohere is the default.
COHERE_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GROQ_API_KEY=
# ollama needs no key

# Optional: seconds of silence before it decides you've finished talking.
# JARVIS_PAUSE=2.5

# Optional: ';'-separated folders to limit the file scan to, instead of every drive.
# JARVIS_ROOT=C:\Users\me\Documents;D:\Projects
